[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/genmap/genmap_dock.gd" id="1_dock"]

[node name="GenMap" type="VBoxContainer"]
custom_minimum_size = Vector2(260, 0)
offset_right = 300.0
offset_bottom = 640.0
theme_override_constants/separation = 6
script = ExtResource("1_dock")

[node name="PromptLabel" type="Label" parent="."]
layout_mode = 2
text = "Prompt"

[node name="PromptEdit" type="TextEdit" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 110)
layout_mode = 2
placeholder_text = "mazmorra de 20x20 con 3 habitaciones y 2 cofres"
wrap_mode = 1

[node name="ModelLabel" type="Label" parent="."]
layout_mode = 2
text = "Modelo (Ollama)"

[node name="ModelRow" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="ModelOption" type="OptionButton" parent="ModelRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
